{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KurrentDb": {
    "ConnectionString": "kurrentdb://localhost:6002?tls=false",
    "ReadModelHydration": {
      "SubscriptionName": "read-model-hydrator-subscription",
      "CheckpointAfterMs": 200,
      "CheckpointLowerBound": 1,
      "CheckpointUpperBound": 10
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://hbm_accounts:hbm_accounts_pass@localhost:6003",
    "DatabaseName": "accounts"
  },
  "Cors": {
    "AllowedOrigins": [ "*" ],
    "AllowedMethods": [ "*" ],
    "AllowedHeaders": [ "*" ]
  },
  "AllowedHosts": "*"
}
